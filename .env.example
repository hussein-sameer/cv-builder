# Copy to .env (local) or set these as environment variables on your host. Every value is optional.

# ---------------------------------------------------------------- accounts
# AUTH_ENABLED=true              # false = no login, single local user (only for use on your own machine)
# SIGNUP_ENABLED=true            # false = only existing users can log in (create users with: python -m app.manage create-user)
# ADMIN_EMAILS=you@example.com   # comma-separated; admins have no daily AI limit
# SESSION_DAYS=30
# COOKIE_SECURE=auto             # auto = Secure cookie when the request is HTTPS
# SECRET_KEY=                    # encrypts API keys users save to their accounts. Required on Postgres (on SQLite a
#                                # secret.key file is created next to the DB). Changing it makes saved keys unreadable.

# ---------------------------------------------------------------- database
# Default: SQLite file in DATA_DIR. Set a Postgres URL for hosted deployments.
# Northflank's Postgres addon provides POSTGRES_URI, which is also read automatically.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATA_DIR=./data

# ---------------------------------------------------------------- AI (server-side keys are shared with all signed-in users)
# Leave the *_API_KEY values empty to make every user bring (and save) their own key.
# AI_DEFAULT_PROVIDER=openai          # openai | anthropic | gemini | ollama
# AI_DAILY_LIMIT=30                   # generations per user per day on the shared key (0 = unlimited); own keys are never limited

# OpenAI-compatible (OpenAI, OpenRouter, Groq, DeepSeek, Mistral…)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# GEMINI_API_KEY=
# GEMINI_MODEL=

# Ollama — only reachable when the server can reach it (local/Docker installs)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1

# Security for public servers
# ALLOW_CUSTOM_BASE_URLS=true     # let users point the AI at their own endpoint (with their own key)
# ALLOW_PRIVATE_BASE_URLS=false   # defaults to false when accounts are on: blocks localhost/private IPs (SSRF)
# AI_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------- misc
# PDF_FONT_DIRS=                  # extra font folders for the PDF renderer
# CORS_ORIGINS=http://localhost:5173
